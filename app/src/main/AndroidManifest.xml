<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".LostAndFoundApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Initial launch screen -->
        <activity
            android:name=".SplashActivity"
            android:theme="@style/SplashTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main dashboards -->
        <activity android:name=".CampusDashboardActivity" />
        <activity android:name=".DashboardActivity" />
        <activity android:name=".AdminDashboardActivity" />
        <activity android:name=".AdminRequestsActivity" />
        <activity android:name=".ManageItemsActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".AllUsersActivity" android:windowSoftInputMode="adjustPan" />

        <!-- Profile -->
        <activity
            android:name=".UserProfileActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CampusMyItemsActivity" />

        <!-- Login and Authentication -->
        <activity
            android:name=".UserLoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Account Registration -->
        <activity
            android:name=".UserRegistrationActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CreateNewPasswordActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- Primary Deep Link: campus-lost-found://reset-password?token=XYZ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="campus-lost-found"
                    android:host="reset-password" />
            </intent-filter>

            <!-- Production App Link: https://campuslostandfound.com/reset?token=XYZ -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="campuslostandfound.com"
                    android:pathPrefix="/reset" />
            </intent-filter>
        </activity>

        <!-- Item Details -->
        <activity android:name=".ItemDetailActivity" />

        <!-- Item Browsing -->
        <activity android:name=".BrowseItemsActivity" />

        <!-- Report Activities -->
        <activity
            android:name=".CampusReportLostActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CampusReportFoundActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReportToAdminActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AdminReportManagementActivity" />
        <activity android:name=".AdminReportDetailsActivity" />
        <activity android:name=".AdminReportReviewActivity" />

        <activity android:name=".DeveloperInfoActivity" />
        <activity android:name=".LostAndFoundPolicyActivity" />
        <activity android:name=".AllReportedItemsActivity" />
        <activity android:name=".NotificationsActivity" />
        <activity android:name=".ClaimDetailsActivity" />

        <activity android:name=".FullScreenImageActivity"
            android:theme="@style/Theme.App.FullScreen"
            android:launchMode="singleTop" />

    </application>

</manifest>