<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Component and Helper Styles -->
    <style name="Widget.App.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:padding">12dp</item>
    </style>

    <!-- Splash screen theme - Updated to follow design rules (no fullscreen) -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background_color</item>
        <item name="android:statusBarColor">@color/splash_background_color</item>
        <item name="android:navigationBarColor">@color/splash_background_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- On Android 12+, disable system splash icon to avoid duplicate logo -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleAppearanceOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>