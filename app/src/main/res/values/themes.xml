<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryLightColor</item>
        <item name="colorOnPrimaryContainer">@color/primaryDarkColor</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accentColor</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Navigation Drawer Selected Item Background -->
        <item name="colorSecondaryContainer">@color/primaryLightColor</item>
        <item name="colorOnSecondaryContainer">@color/primaryColor</item>

        <!-- Background and surface -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        <!-- Status bar color - Telegram X Style -->
        <item name="android:statusBarColor">@color/primaryDarkColor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>

        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>

        <!-- Animation style -->
        <item name="android:windowAnimationStyle">@style/Animation.App.Activity</item>

        <!-- Use materialTimePickerTheme for styling the MaterialTimePicker -->
        <item name="materialTimePickerTheme">@style/ThemeOverlay.App.TimePicker.Light</item>

        <!-- Use materialCalendarTheme for styling the MaterialDatePicker -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.App.DatePicker.Light</item>
        
        <!-- TextInputLayout Style -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        
        <!-- Exposed Dropdown Popup Background -->
        <item name="android:popupBackground">@color/dropdown_popup_bg</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="errorTextColor">@color/error_dark</item>
        <item name="boxStrokeErrorColor">@color/error_dark</item>
        <item name="errorIconTint">@color/error_dark</item>
        <item name="hintTextColor">@color/primaryColor</item>
    </style>

    <!-- Theme Overlay for NavigationView to style the navigation panel dynamically -->
    <style name="ThemeOverlay.App.NavigationView" parent="">
        <item name="colorSurface">@color/nav_drawer_bg</item>
        <item name="colorOnSurface">@color/nav_drawer_item_inactive_text</item>
        <item name="colorOnSurfaceVariant">@color/nav_drawer_item_inactive_text</item>
        <item name="colorSecondaryContainer">@color/nav_drawer_item_indicator</item>
        <item name="colorOnSecondaryContainer">@color/nav_drawer_item_active_text</item>
        <item name="colorOutline">@color/nav_drawer_divider_color</item>
    </style>

    <style name="Theme.App.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Theme Overlay for TimePicker to achieve the requested look (Light Mode) -->
    <style name="ThemeOverlay.App.TimePicker.Light" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <!-- Responsive sizing to make it slightly larger and comfortable on all devices -->
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="windowMinWidthMajor">65%</item>
        <item name="windowMinWidthMinor">90%</item>

        <!-- Main dialog and Header background (Matching dropdown menus surface) -->
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorContainer">@color/surfaceColor</item>
        <item name="colorSurfaceContainer">@color/surfaceColor</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceColor</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceColor</item>

        <!-- "Select Time" title text color and Separator (Dark navy) -->
        <item name="colorOnSurface">@color/picker_text_primary</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TimePicker.Title.Light</item>

        <!-- Hour and Minute Display (Header Chips) -->
        <!-- Selected Chip (e.g. "07") - High-contrast blue background, White text -->
        <item name="colorPrimaryContainer">@color/picker_primary_blue</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Unselected Chip (e.g. "16") - Soft light blue background, Dark navy text -->
        <item name="colorSurfaceVariant">@color/picker_light_blue</item>
        <item name="colorOnSurfaceVariant">@color/picker_text_primary</item>

        <!-- Border for chips (Accessible blue) -->
        <item name="colorOutline">@color/picker_primary_blue</item>

        <!-- AM/PM Toggle -->
        <!-- Selected background (Accessible blue) and text (White) -->
        <item name="colorTertiaryContainer">@color/picker_primary_blue</item>
        <item name="colorOnTertiaryContainer">@color/white</item>
        <!-- Unselected background (White) and text (Dark navy) -->
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/picker_text_primary</item>
        <!-- Border for AM/PM buttons -->
        <item name="colorOutlineVariant">@color/picker_primary_blue</item>

        <!-- Analog Clock selector hand, center dot, and action buttons (Accessible blue) -->
        <item name="colorPrimary">@color/picker_primary_blue</item>
        <!-- Number inside selector circle -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Dial numbers styling -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.TimePicker.LabelBold.Light</item>
        <!-- Time digits display styling -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.TimePicker.Headline.Light</item>
 
        <item name="materialTimePickerStyle">@style/Widget.App.MaterialTimePicker.Light</item>
    </style>

    <style name="TextAppearance.App.TimePicker.Title.Light" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/picker_text_primary</item>
    </style>
 
    <style name="TextAppearance.App.TimePicker.Headline.Light" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
 
    <style name="TextAppearance.App.TimePicker.LabelBold.Light" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/clock_number_color_light</item>
    </style>
 
    <style name="Widget.App.MaterialTimePicker.Light" parent="Widget.Material3.MaterialTimePicker">
        <!-- Dial background (Soft circular light blue) -->
        <item name="clockFaceBackgroundColor">@color/picker_light_blue</item>
        <!-- Dial numbers color selector -->
        <item name="clockNumberTextColor">@color/clock_number_color_light</item>
    </style>

    <!-- Refined Theme Overlay for DatePicker for high contrast and brand consistency (Light Mode) -->
    <style name="ThemeOverlay.App.DatePicker.Light" parent="ThemeOverlay.Material3.MaterialCalendar">
        <!-- Responsive sizing to make it slightly larger and comfortable on all devices -->
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="windowMinWidthMajor">65%</item>
        <item name="windowMinWidthMinor">90%</item>

        <!-- Header background and selected date circle (Accessible blue) -->
        <item name="colorPrimary">@color/picker_primary_blue</item>
        <!-- Header text and selected date text (High contrast white) -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Main calendar background (Matching dropdown menus surface) -->
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorContainer">@color/surfaceColor</item>
        <item name="colorSurfaceContainer">@color/surfaceColor</item>
        <item name="colorSurfaceContainerHigh">@color/surfaceColor</item>
        <item name="colorSurfaceContainerHighest">@color/surfaceColor</item>

        <!-- Date numbers and Day labels (Dark navy for high contrast) -->
        <item name="colorOnSurface">@color/picker_text_primary</item>
        <!-- Secondary text like month navigation icons and weekdays (Dark navy for high contrast) -->
        <item name="colorOnSurfaceVariant">@color/picker_text_primary</item>

        <!-- Controls like "OK" and "CANCEL" (Accessible blue) -->
        <item name="colorSecondary">@color/picker_primary_blue</item>

        <!-- Custom Header Layout to apply gradient and rounded top corners -->
        <item name="materialCalendarHeaderLayout">@style/Widget.App.MaterialCalendar.HeaderLayout</item>
        <!-- Custom Header text styling for high contrast (pure white text) -->
        <item name="materialCalendarHeaderTitle">@style/Widget.App.MaterialCalendar.HeaderTitle</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.App.MaterialCalendar.HeaderSelection</item>
        <!-- Custom body text style mappings for unified typography -->
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.DatePicker.Month.Light</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.DatePicker.Weekday.Light</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.DatePicker.Day.Light</item>
    </style>

    <style name="Widget.App.MaterialCalendar.HeaderLayout" parent="Widget.Material3.MaterialCalendar.HeaderLayout">
        <item name="android:background">@drawable/bg_picker_header_gradient</item>
    </style>

    <style name="Widget.App.MaterialCalendar.HeaderTitle" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.MaterialCalendar.HeaderSelection" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Month.Light" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/picker_text_primary</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Weekday.Light" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Day.Light" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Shape Styles -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">30dp</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="strokeColor">@color/primaryColor</item>
        <item name="android:textColor">@color/primaryColor</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surfaceColor</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.App.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <!-- Activity transition animations -->
    <style name="Animation.App.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/material_shared_axis_z_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/material_shared_axis_z_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/material_shared_axis_z_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/material_shared_axis_z_pop_exit</item>
    </style>
</resources>