<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Number color when selected/active (inside the primary color circle/hand tip) -->
    <item android:state_selected="true" android:color="@color/white" />
    <item android:state_activated="true" android:color="@color/white" />
    <item android:state_checked="true" android:color="@color/white" />
    <!-- Default number color on the light dial -->
    <item android:color="@color/picker_text_primary" />
</selector>
