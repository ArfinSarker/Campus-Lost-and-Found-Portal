<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryDarkColor"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title=""
            app:titleTextColor="@color/white">

            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/title_my_profile"
                android:textColor="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Image Section -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                        app:strokeColor="@color/profile_avatar_stroke"
                        app:strokeWidth="2dp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabChangePhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:backgroundTint="@color/profile_fab_bg"
                        android:src="@drawable/ic_edit"
                        app:fabCustomSize="36dp"
                        app:maxImageSize="18dp"
                        app:tint="@color/profile_fab_tint"
                        android:contentDescription="@string/change_photo" />
                </FrameLayout>

                <!-- Information Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/label_information_profile"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/profile_section_title"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.2dp"
                    app:strokeColor="@color/profile_card_stroke"
                    app:cardBackgroundColor="@color/profile_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Full Name -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilFullName"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/hint_full_name"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="@color/profile_icon_full_name">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFullName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- University ID (Not Changeable) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUniversityId"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:enabled="false"
                            android:hint="@string/hint_university_id"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:helperText="@string/label_not_changeable"
                            app:startIconDrawable="@drawable/ic_id_card"
                            app:startIconTint="@color/profile_icon_university_id">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUniversityId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Gender (Changeable Dropdown) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilGender"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/hint_gender"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_users"
                            app:startIconTint="@color/profile_icon_gender">

                            <AutoCompleteTextView
                                android:id="@+id/actvGender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="none"
                                android:textColor="@color/profile_field_text_color"
                                android:popupBackground="@color/profile_dropdown_popup_bg" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Designation (Staff Only, Editable) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDesignation"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="Designation"
                            android:visibility="gone"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_list"
                            app:startIconTint="@color/profile_icon_designation">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDesignation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="text"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Department (Editable) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDepartment"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/hint_department"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_building"
                            app:startIconTint="@color/profile_icon_department">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDepartment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="text"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Batch (Student Only, Editable) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBatch"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/hint_batch"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_users"
                            app:startIconTint="@color/profile_icon_batch">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBatch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="text"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Level & Term (Student Only, Editable Dropdown) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilLevelTerm"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/label_level_term"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_layers"
                            app:startIconTint="@color/profile_icon_level_term">

                            <AutoCompleteTextView
                                android:id="@+id/actvLevelTerm"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="none"
                                android:textColor="@color/profile_field_text_color"
                                android:popupBackground="@color/profile_dropdown_popup_bg" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Section (Student Only, Editable Dropdown) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilSection"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_section"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_list"
                            app:startIconTint="@color/profile_icon_section">

                            <AutoCompleteTextView
                                android:id="@+id/actvSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="none"
                                android:textColor="@color/profile_field_text_color"
                                android:popupBackground="@color/profile_dropdown_popup_bg" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Contact Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/label_contact_profile"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textColor="@color/profile_section_title"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.2dp"
                    app:strokeColor="@color/profile_card_stroke"
                    app:cardBackgroundColor="@color/profile_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="@string/hint_email"
                            app:boxBackgroundColor="@color/profile_input_bg"
                            app:boxStrokeColor="@color/profile_box_stroke"
                            android:textColorHint="@color/profile_input_hint"
                            app:hintTextColor="@color/profile_border_color_focused"
                            app:endIconDrawable="@drawable/ic_edit"
                            app:endIconMode="custom"
                            app:endIconTint="@color/profile_edit_icon_color"
                            app:startIconDrawable="@drawable/ic_email"
                            app:startIconTint="@color/profile_icon_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:inputType="textEmailAddress"
                                android:textColor="@color/profile_field_text_color" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Country Code Selection -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilCountryCode"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="153dp"
                                android:layout_height="0dp"
                                android:hint="Code"
                                app:boxBackgroundColor="@color/profile_input_bg"
                                app:boxStrokeColor="@color/profile_box_stroke"
                                android:textColorHint="@color/profile_input_hint"
                                app:hintTextColor="@color/profile_border_color_focused"
                                app:boxCornerRadiusBottomEnd="8dp"
                                app:boxCornerRadiusBottomStart="8dp"
                                app:boxCornerRadiusTopEnd="8dp"
                                app:boxCornerRadiusTopStart="8dp"
                                app:startIconDrawable="@drawable/ic_phone"
                                app:startIconTint="@color/profile_icon_phone"
                                app:endIconMode="none"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/tilPhone"
                                app:layout_constraintBottom_toBottomOf="@+id/tilPhone">

                                <AutoCompleteTextView
                                    android:id="@+id/actvCountryCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:enabled="false"
                                    android:minHeight="56dp"
                                    android:paddingTop="16dp"
                                    android:paddingBottom="16dp"
                                    android:inputType="text"
                                    android:textColor="@color/profile_field_text_color"
                                    android:popupBackground="@color/profile_dropdown_popup_bg" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Phone Number Body -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPhone"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_phone"
                                app:boxBackgroundColor="@color/profile_input_bg"
                                app:boxStrokeColor="@color/profile_box_stroke"
                                android:textColorHint="@color/profile_input_hint"
                                app:hintTextColor="@color/profile_border_color_focused"
                                app:endIconDrawable="@drawable/ic_edit"
                                app:endIconMode="custom"
                                app:endIconTint="@color/profile_edit_icon_color"
                                app:boxCornerRadiusBottomEnd="8dp"
                                app:boxCornerRadiusBottomStart="8dp"
                                app:boxCornerRadiusTopEnd="8dp"
                                app:boxCornerRadiusTopStart="8dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/tilCountryCode"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginStart="8dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPhone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:enabled="false"
                                    android:minHeight="56dp"
                                    android:paddingTop="16dp"
                                    android:paddingBottom="16dp"
                                    android:inputType="phone"
                                    android:textColor="@color/profile_field_text_color" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Activity Information Section (Admin Only) -->
                <LinearLayout
                    android:id="@+id/llActivitySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/label_activity_info"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/profile_section_title"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.2dp"
                        app:strokeColor="@color/profile_card_stroke"
                        app:cardBackgroundColor="@color/profile_card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvLostReportsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/label_lost_reports_count"
                                android:textColor="@color/profile_text_primary" />

                            <TextView
                                android:id="@+id/tvFoundReportsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/label_found_reports_count"
                                android:textColor="@color/profile_text_primary" />

                            <TextView
                                android:id="@+id/tvReturnedItemsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_returned_items_count"
                                android:textColor="@color/profile_text_primary" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Change Password Section -->
                <LinearLayout
                    android:id="@+id/llChangePasswordSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/label_change_password_profile"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/profile_section_title"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.2dp"
                        app:strokeColor="@color/profile_card_stroke"
                        app:cardBackgroundColor="@color/profile_card_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilOldPassword"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:hint="@string/label_old_password"
                                app:boxBackgroundColor="@color/profile_input_bg"
                                app:boxStrokeColor="@color/profile_box_stroke"
                                android:textColorHint="@color/profile_input_hint"
                                app:hintTextColor="@color/profile_border_color_focused"
                                app:passwordToggleEnabled="true"
                                app:passwordToggleTint="@color/profile_eye_icon_color"
                                app:startIconDrawable="@drawable/ic_lock"
                                app:startIconTint="@color/profile_icon_old_password">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etOldPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword"
                                    android:textColor="@color/profile_field_text_color" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilNewPassword"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:hint="@string/hint_new_password"
                                app:boxBackgroundColor="@color/profile_input_bg"
                                app:boxStrokeColor="@color/profile_box_stroke"
                                android:textColorHint="@color/profile_input_hint"
                                app:hintTextColor="@color/profile_border_color_focused"
                                app:passwordToggleEnabled="true"
                                app:passwordToggleTint="@color/profile_eye_icon_color"
                                app:startIconDrawable="@drawable/ic_lock"
                                app:startIconTint="@color/profile_icon_new_password">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etNewPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword"
                                    android:textColor="@color/profile_field_text_color" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilConfirmPassword"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:hint="@string/hint_confirm_password"
                                app:boxBackgroundColor="@color/profile_input_bg"
                                app:boxStrokeColor="@color/profile_box_stroke"
                                android:textColorHint="@color/profile_input_hint"
                                app:hintTextColor="@color/profile_border_color_focused"
                                app:passwordToggleEnabled="true"
                                app:passwordToggleTint="@color/profile_eye_icon_color"
                                app:startIconDrawable="@drawable/ic_lock"
                                app:startIconTint="@color/profile_icon_confirm_password">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etConfirmPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPassword"
                                    android:textColor="@color/profile_field_text_color" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConfirmPasswordChange"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:text="Confirm Change"
                                android:textColor="@color/profile_button_text"
                                android:backgroundTint="@color/profile_button_bg"
                                android:textAllCaps="false"
                                android:visibility="gone"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Admin Action Section (Delete User) - Redesigned to match Sign In button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/btn_delete_user"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:backgroundTint="@color/errorColor"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

                <!-- Save Changes Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/btn_save_changes"
                        android:textColor="@color/profile_button_text"
                        android:backgroundTint="@color/profile_button_bg"
                        app:iconTint="@color/profile_button_text"
                        android:visibility="gone"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/loadingAnimation"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/submit_loader" />
                </FrameLayout>

                <View
                    android:id="@+id/keyboardSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
