<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_header_bg"
    android:fitsSystemWindows="true">

    <!-- Header Bar -->
    <RelativeLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/editor_header_bg"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/textPrimary"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Editing Photo"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/staging_btn_send_bg"
            app:cornerRadius="20dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Segmented Control Mode Switch (Preview vs Edit) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSegmentedControl"
        android:layout_width="220dp"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/editor_segmented_bg"
        app:layout_constraintTop_toBottomOf="@id/toolbarHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnModePreview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Preview"
                android:textColor="@color/editor_segmented_text_inactive"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnModeEdit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Edit"
                android:textColor="@color/editor_segmented_text_active"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_segmented_active"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Center Canvas Preview Area -->
    <FrameLayout
        android:id="@+id/editorContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardSegmentedControl"
        app:layout_constraintBottom_toTopOf="@id/layoutAdjustmentControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivEditorPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Editor Canvas" />

        <com.sas.lostandfound.CropOverlayView
            android:id="@+id/cropOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Professional Crop Toolbar Container (Shown in Crop Mode) -->
    <LinearLayout
        android:id="@+id/layoutCropControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/crop_toolbar_bg"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/rvEditorThumbnails">

        <!-- Crop Header: Cancel, Title, Undo, Redo, Apply -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnCropCancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/textPrimary"
                android:contentDescription="Cancel Crop" />

            <TextView
                android:id="@+id/tvCropTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Crop &amp; Straighten"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingHorizontal="8dp" />

            <ImageButton
                android:id="@+id/btnCropUndo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                app:tint="@color/textPrimary"
                android:contentDescription="Undo Crop Step" />

            <ImageButton
                android:id="@+id/btnCropRedo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:rotationY="180"
                app:tint="@color/textPrimary"
                android:contentDescription="Redo Crop Step" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropApply"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:backgroundTint="@color/crop_btn_apply_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/white"
                android:contentDescription="Apply Crop" />
        </LinearLayout>

        <!-- Aspect Ratio Presets Horizontal Scroll View -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutAspectRatios"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatioFree"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free"
                    android:textColor="@color/crop_chip_text_active"
                    app:chipBackgroundColor="@color/crop_chip_bg_active"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatioOriginal"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio11"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1:1 (Square)"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio32"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3:2"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio43"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:3"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio54"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:4"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio169"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:9"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatio916"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9:16"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRatioCircle"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"
                    android:textColor="@color/crop_chip_text_inactive"
                    app:chipBackgroundColor="@color/crop_chip_bg_inactive" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Transform Controls (Rotate & Flip) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnCropRotateLeft"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_rotate"
                android:rotationY="180"
                app:tint="@color/textPrimary"
                android:contentDescription="Rotate Left 90" />

            <ImageButton
                android:id="@+id/btnCropRotateRight"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_rotate"
                app:tint="@color/textPrimary"
                android:contentDescription="Rotate Right 90" />

            <ImageButton
                android:id="@+id/btnCropFlipH"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_flip"
                app:tint="@color/textPrimary"
                android:contentDescription="Flip Horizontal" />

            <ImageButton
                android:id="@+id/btnCropFlipV"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_flip"
                android:rotation="90"
                app:tint="@color/textPrimary"
                android:contentDescription="Flip Vertical" />
        </LinearLayout>

        <!-- Straighten Slider (-45 to +45) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvStraightenLabel"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:text="Straighten: 0°"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStraighten"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-45.0"
                android:valueTo="45.0"
                android:value="0.0"
                app:thumbColor="@color/crop_handle_color"
                app:trackColorActive="@color/crop_handle_color"
                app:trackColorInactive="@color/editor_slider_track" />
        </LinearLayout>

    </LinearLayout>

    <!-- Adjustment Sliders Container (Shown in Edit Mode) -->
    <LinearLayout
        android:id="@+id/layoutAdjustmentControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/editor_header_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomTools">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSliderLabel"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Brightness"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderAdjustment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:thumbColor="@color/editor_slider_thumb"
                app:trackColorActive="@color/editor_slider_thumb"
                app:trackColorInactive="@color/editor_slider_track" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom 9-Tool Toolbar -->
    <HorizontalScrollView
        android:id="@+id/layoutBottomTools"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/editor_header_bg"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/rvEditorThumbnails">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- 1. Crop Tool -->
            <LinearLayout
                android:id="@+id/toolCrop"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 2. Rotate Tool -->
            <LinearLayout
                android:id="@+id/toolRotate"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_rotate"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rotate"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 3. Flip Tool -->
            <LinearLayout
                android:id="@+id/toolFlip"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_flip"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flip"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 4. Adjust Tool -->
            <LinearLayout
                android:id="@+id/toolAdjust"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adjust"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 5. Filters Tool -->
            <LinearLayout
                android:id="@+id/toolFilters"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filters"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 6. Text Tool -->
            <LinearLayout
                android:id="@+id/toolText"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_text_tool"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 7. Emoji Tool -->
            <LinearLayout
                android:id="@+id/toolEmoji"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_emoji_tool"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emoji"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 8. Draw Tool -->
            <LinearLayout
                android:id="@+id/toolDraw"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_draw"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Draw"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 9. Reset Tool -->
            <LinearLayout
                android:id="@+id/toolReset"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:textColor="@color/textPrimary"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Thumbnails Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEditorThumbnails"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/editor_header_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
