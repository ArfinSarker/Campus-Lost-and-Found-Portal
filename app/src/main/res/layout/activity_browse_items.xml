<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/search_screen_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/search_header_bg"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/search_header_back_icon_tint"
            app:title="@string/title_browse_items"
            android:layout_gravity="center_horizontal"
            app:titleTextColor="@color/search_header_title">

            <androidx.appcompat.widget.ActionMenuView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end" />

            <ImageView
                android:id="@+id/ivFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/search_header_filter_icon_tint"
                android:contentDescription="@null" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Search Bar -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:hint="@string/hint_search_items"
                    app:endIconMode="clear_text"
                    app:boxBackgroundColor="@color/search_input_bg"
                    app:boxStrokeColor="@color/search_input_box_stroke"
                    app:hintTextColor="@color/search_label_focused"
                    android:textColorHint="@color/search_input_placeholder"
                    app:startIconTint="@color/search_input_search_icon_tint"
                    app:endIconTint="@color/search_input_clear_icon_tint"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:startIconDrawable="@drawable/ic_search">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/search_input_text"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category Filter Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCategoryFilter"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/label_category"
                    app:boxBackgroundColor="@color/search_input_bg"
                    app:boxStrokeColor="@color/search_dropdown_box_stroke"
                    app:hintTextColor="@color/search_dropdown_focused_label"
                    android:textColorHint="@color/search_input_placeholder"
                    app:endIconTint="@color/search_dropdown_arrow_tint"
                    app:layout_constraintTop_toBottomOf="@id/tilSearch">

                    <AutoCompleteTextView
                        android:id="@+id/actvCategoryFilter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/search_dropdown_text"
                        android:popupBackground="@color/search_dropdown_popup_bg" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Status Filter Section -->
                <HorizontalScrollView
                    android:id="@+id/hsvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@id/tilCategoryFilter">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:chipBackgroundColor="@color/search_chip_all_bg"
                            app:chipStrokeColor="@color/search_chip_all_stroke"
                            android:textColor="@color/search_chip_all_text"
                            android:text="@string/chip_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLost"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipBackgroundColor="@color/search_chip_lost_bg"
                            app:chipStrokeColor="@color/search_chip_lost_stroke"
                            android:textColor="@color/search_chip_lost_text"
                            android:text="@string/chip_lost" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFound"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipBackgroundColor="@color/search_chip_found_bg"
                            app:chipStrokeColor="@color/search_chip_found_stroke"
                            android:textColor="@color/search_chip_found_text"
                            android:text="@string/chip_found" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipClaimed"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipBackgroundColor="@color/search_chip_resolved_bg"
                            app:chipStrokeColor="@color/search_chip_resolved_stroke"
                            android:textColor="@color/search_chip_resolved_text"
                            android:text="@string/chip_claimed" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Items List Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/hsvCategories"
                    tools:listitem="@layout/item_browse_card" />

                <!-- Empty State Design -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/hsvCategories">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_inbox"
                        app:tint="@color/textSecondary"
                        android:contentDescription="@null" />

                    <TextView
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/no_items_found" />

                    <TextView
                        style="@style/TextAppearance.App.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/adjust_search_filters" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
