<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/item_details_header_bg"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/item_details_icon_nav_back"
            app:title=""
            app:titleTextColor="@color/item_details_header_title">

            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/item_details_header_title"
                tools:text="Item Name" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Image Slider Section -->
                <FrameLayout
                    android:id="@+id/imageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@color/item_details_image_container_bg">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImageSlider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/ivItemImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_package"
                        tools:ignore="ContentDescription" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_indicator_pill"
                        android:paddingHorizontal="10dp"
                        android:visibility="gone"
                        app:tabBackground="@drawable/slider_indicator_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabMaxWidth="10dp"
                        app:tabMinWidth="10dp"
                        app:tabPaddingEnd="0dp"
                        app:tabPaddingStart="0dp"
                        app:tabMode="fixed"
                        app:tabRippleColor="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_top_rounded"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_marginTop="-24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Status Badge Overlay (Left) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="100dp"
                            app:cardElevation="3dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="#FFFFFF">

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:letterSpacing="0.08"
                                android:fontFamily="sans-serif-medium"
                                tools:text="PENDING" />
                        </com.google.android.material.card.MaterialCardView>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- Report ID Badge Overlay (Right) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardReportId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#CC0F172A"
                            app:cardCornerRadius="100dp"
                            app:cardElevation="3dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#33FFFFFF">

                            <TextView
                                android:id="@+id/tvDisplayId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:letterSpacing="0.06"
                                android:fontFamily="sans-serif-medium"
                                tools:text="#R1" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Edited Label for Admin -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardEditedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/orange_badge_bg"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/orange_badge_icon"
                            app:strokeWidth="1dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Edited"
                                android:textColor="@color/orange_badge_icon"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:id="@+id/ivItemNameIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/item_details_icon_item_name"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvItemNameLabel"
                            style="@style/TextAppearance.App.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/label_item_name_simple"
                            android:textColor="@color/item_details_item_name_label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvItemName"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="16sp"
                        android:textColor="@color/item_details_item_name_val"
                        tools:text="MacBook Pro 14 inch" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:id="@+id/ivCategoryIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_layers"
                            app:tint="@color/item_details_icon_category"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvCategoryLabel"
                            style="@style/TextAppearance.App.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/label_category"
                            android:textColor="@color/item_details_category_label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCategory"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="16sp"
                        android:textColor="@color/item_details_category_val"
                        tools:text="Electronics" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDescriptionIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_file_text"
                            app:tint="@color/item_details_icon_description"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvDescriptionLabel"
                            style="@style/TextAppearance.App.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/label_description_detail"
                            android:textColor="@color/item_details_desc_label" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescription"
                        style="@style/TextAppearance.App.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/item_details_desc_content"
                        tools:text="Space gray MacBook Pro with a stickers on the back. It was in a black leather sleeve." />

                    <!-- New Sections for Lost/Found details -->
                    <LinearLayout
                        android:id="@+id/llLostSpecifics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="24dp">

                            <ImageView
                                android:id="@+id/ivOwnershipIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/item_details_icon_ownership"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvProofOwnershipLabel"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Ownership Verification"
                                android:textColor="@color/item_details_verification_label" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProofOwnership"
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/item_details_verification_val"
                            tools:text="I have the receipt and original box." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llFoundSpecifics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="24dp">

                            <ImageView
                                android:id="@+id/ivHandlingIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_inbox"
                                app:tint="@color/item_details_icon_handling"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvHandlingStatusLabel"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Handling Status"
                                android:textColor="@color/item_details_handling_label" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHandlingStatus"
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/item_details_handling_val"
                            tools:text="Submitted to security office" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="24dp">

                            <ImageView
                                android:id="@+id/ivVerificationIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/item_details_icon_verification"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvVerificationLabel"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Verification &amp; Security"
                                android:textColor="@color/item_details_verification_label" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSecurityQuestion"
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/item_details_verification_val"
                            tools:text="What is the color of the phone case?" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/dividerColor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivLocationIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/item_details_location_icon"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLocationLabel"
                                style="@style/TextAppearance.App.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_location_detail"
                                android:textColor="@color/item_details_location_label" />

                            <TextView
                                android:id="@+id/tvLocation"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/item_details_location_val"
                                tools:text="Central Library, 2nd Floor" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDateTimeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/item_details_date_time_icon"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDateTimeLabel"
                                style="@style/TextAppearance.App.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_date_time_detail"
                                android:textColor="@color/item_details_date_time_label" />

                            <TextView
                                android:id="@+id/tvDateTime"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/item_details_date_time_val"
                                tools:text="Oct 24, 2023 - 10:30 AM" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/dividerColor" />

                    <LinearLayout
                        android:id="@+id/llReportedByContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivReportedByIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_users"
                                app:tint="@color/item_details_icon_reported_by"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvReportedByLabel"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/label_reported_by"
                                android:textColor="@color/item_details_reported_by_label" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivUserPhoto"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_user"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                                tools:ignore="ContentDescription" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReporterName"
                                    style="@style/TextAppearance.App.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/item_details_user_name"
                                    tools:text="Arfin Sarker" />

                                <TextView
                                    android:id="@+id/tvReporterUniversityId"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/item_details_user_id"
                                    android:maxLines="1"
                                    android:ellipsize="none"
                                    tools:text="ID: 0802410205101019" />

                                <TextView
                                    android:id="@+id/tvReporterType"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/item_details_user_role"
                                    tools:text="Student" />

                                <TextView
                                    android:id="@+id/tvReporterDeptOrDesignation"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/item_details_user_designation"
                                    tools:text="Computer Science Department" />

                                <TextView
                                    android:id="@+id/tvPreferredContact"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textStyle="italic"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/item_details_user_contact"
                                    tools:text="Preferred Contact: Email" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/btn_contact"
                            android:textColor="@color/item_details_btn_contact_text"
                            android:visibility="gone"
                            app:backgroundTint="@color/item_details_btn_contact_bg"
                            app:strokeColor="@color/item_details_btn_contact_stroke"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- Resolved User Info Section -->
                    <LinearLayout
                        android:id="@+id/llResolutionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="24dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivReturnedToIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_user_check"
                                app:tint="@color/item_details_icon_returned_to"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvResolutionTitle"
                                style="@style/TextAppearance.App.SectionTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:textColor="@color/item_details_returned_to_label"
                                tools:text="Returned To" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivResolvedUserPhoto"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_user"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                                tools:ignore="ContentDescription" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvResolvedUserName"
                                    style="@style/TextAppearance.App.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/item_details_user_name"
                                    tools:text="Jane Smith" />

                                <TextView
                                    android:id="@+id/tvResolvedUserUniversityId"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textColor="@color/item_details_user_id"
                                    android:maxLines="1"
                                    android:ellipsize="none"
                                    tools:text="ID: 180201099" />

                                <TextView
                                    android:id="@+id/tvResolvedUserType"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/item_details_user_role"
                                    tools:text="Student" />

                                <TextView
                                    android:id="@+id/tvResolvedUserDeptOrDesignation"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/item_details_user_designation"
                                    tools:text="Computer Science Department" />

                                <TextView
                                    android:id="@+id/tvResolvedUserPreferredContact"
                                    style="@style/TextAppearance.App.Small"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textStyle="italic"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/item_details_user_contact"
                                    android:visibility="gone"
                                    tools:text="Preferred Contact: Email" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResolvedUserContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/btn_contact"
                            android:textColor="@color/item_details_btn_contact_text"
                            android:visibility="gone"
                            app:backgroundTint="@color/item_details_btn_contact_bg"
                            app:strokeColor="@color/item_details_btn_contact_stroke"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClaim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:text="@string/btn_found_this" />

                    <!-- Reporter Actions Container -->
                    <LinearLayout
                        android:id="@+id/llReporterActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="Edit Report"
                            android:textColor="@color/item_details_btn_edit_text"
                            app:backgroundTint="@color/item_details_btn_edit_bg"
                            app:strokeColor="@color/item_details_btn_edit_stroke"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_pen"
                            app:iconGravity="textStart"
                            app:iconTint="@color/item_details_icon_btn_edit" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReturnToOwner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/btn_return_to_owner"
                            android:textColor="@color/item_details_btn_return_text"
                            app:backgroundTint="@color/item_details_btn_return_bg"
                            app:strokeColor="@color/item_details_btn_return_stroke"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_arrow_back"
                            app:iconGravity="textStart"
                            app:iconTint="@color/item_details_icon_btn_return"
                            android:visibility="gone"
                            tools:visibility="visible"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMarkAsClaimed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Mark as Claimed"
                            android:textColor="@color/item_details_btn_claimed_text"
                            app:backgroundTint="@color/item_details_btn_claimed_bg"
                            app:strokeColor="@color/item_details_btn_claimed_stroke"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_check"
                            app:iconGravity="textStart"
                            app:iconTint="@color/item_details_icon_btn_claimed"
                            android:visibility="gone"
                            tools:visibility="visible"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReporterDelete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Delete Report"
                            android:textColor="@color/item_details_btn_delete_text"
                            app:backgroundTint="@color/item_details_btn_delete_bg"
                            app:strokeColor="@color/item_details_btn_delete_stroke"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconTint="@color/item_details_icon_btn_delete" />

                    </LinearLayout>

                    <!-- Delete Item Button - Redesigned to match Sign In button style -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/btn_delete_report"
                        android:textColor="@color/item_details_btn_admin_delete_text"
                        android:visibility="gone"
                        app:backgroundTint="@color/item_details_btn_admin_delete_bg"
                        app:strokeColor="@color/item_details_btn_admin_delete_stroke"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconTint="@color/item_details_icon_btn_admin_delete" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
