<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_f8fafc"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:paddingHorizontal="16dp">

            <!-- Left-aligned branding (Logo + App Name) -->
            <LinearLayout
                android:id="@+id/layoutBranding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/logo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/lost_part"
                        android:textColor="@color/text_0f172a"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/found_part"
                        android:textColor="@color/primaryDarkColor"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />
                </LinearLayout>
            </LinearLayout>

            <!-- Modern Pill Gradient Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="18dp"
                android:text="@string/sign_in"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_btn_signin_accent"
                app:backgroundTint="@null"
                app:elevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Elegant hairline bottom border divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_e2e8f0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp"
                    app:cardPreventCornerOverlap="false">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashboard_intro">

                        <!-- Semi-transparent decorative search icon on the right (visible perfectly) -->
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="-10dp"
                            android:alpha="0.25"
                            android:src="@drawable/ic_search"
                            app:tint="@color/white"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="18dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/dashboardHeadline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboardHeadline"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:shadowColor="#3F000000"
                                android:shadowDx="0"
                                android:shadowDy="2"
                                android:shadowRadius="6"
                                android:letterSpacing="0.01" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- Report Lost Button (Redesigned Modern Glassmorphism Hybrid) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportLost"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/report_lost_btn"
                        android:textAllCaps="false"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/statusLost"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:minWidth="110dp"
                        android:background="@drawable/bg_btn_report_lost"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_alert_circle"
                        app:iconGravity="textStart"
                        app:iconTint="@color/statusLost"
                        app:iconSize="16dp"
                        app:iconPadding="4dp"
                        app:elevation="0dp" />

                    <!-- Report Found Button (Redesigned Modern Glassmorphism Hybrid) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReportFound"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/report_found_btn"
                        android:textAllCaps="false"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/statusFound"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:minWidth="110dp"
                        android:background="@drawable/bg_btn_report_found"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_check_circle"
                        app:iconGravity="textStart"
                        app:iconTint="@color/statusFound"
                        app:iconSize="16dp"
                        app:iconPadding="4dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/recent_reports_title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_list_row" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMore"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/view_more"
                    android:textAllCaps="false"
                    android:textColor="@color/primaryColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/dashboard_btn_bg"
                    app:strokeColor="@color/divider_e2e8f0"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    app:rippleColor="@color/primaryLightColor"
                    app:icon="@drawable/ic_chevron_down"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/primaryColor"
                    app:iconSize="18dp"
                    app:iconPadding="8dp"
                    app:elevation="0dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="32dp"
                    android:background="@color/dividerColor" />

                <TextView
                    style="@style/TextAppearance.App.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/made_for_users" />

                <TextView
                    android:id="@+id/tvDeveloperInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_dev_info_button"
                    android:text="@string/developer_info"
                    android:textAlignment="center"
                    android:textColor="@color/dev_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
