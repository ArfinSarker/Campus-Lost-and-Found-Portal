<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="6dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:clipToOutline="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/primaryLightColor"
    app:cardBackgroundColor="@color/surfaceColor"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Prominent landscape image section at the top of the card (4:3 ratio for native mobile camera formats) -->
        <FrameLayout
            android:id="@+id/flImageContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#F8FAFC"
            app:layout_constraintDimensionRatio="H,4:3.3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Image Slider for multiple images -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerSlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Single image display -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_package"
                android:contentDescription="@null" />

            <!-- Slider Indicators -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                android:visibility="gone"
                app:tabBackground="@drawable/slider_indicator_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="14dp"
                app:tabMinWidth="14dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@null" />

            <!-- Soft top gradient scrim to ensure overlay badge text is always readable -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_bottom_gradient_overlay"
                android:alpha="0.45" />

        </FrameLayout>

        <!-- Overlaid Badges Row (ID and Type floating on the image) -->
        <TextView
            android:id="@+id/tvReportId"
            style="@style/TextAppearance.App.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_status_badge_found"
            android:backgroundTint="@color/primaryDarkColor"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3.5dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="9.5sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="L1" />

        <TextView
            android:id="@+id/tvItemType"
            style="@style/TextAppearance.App.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_status_badge_lost"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3.5dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="9.5sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Lost" />

        <!-- Details information panel below the image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp"
            android:paddingTop="9dp"
            app:layout_constraintTop_toBottomOf="@id/flImageContainer"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Styled Gradient Divider with Center Package Icon Badge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-2dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_divider_fade" />

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_accent_light">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_package"
                        app:tint="@color/primaryColor"
                        android:contentDescription="@null" />
                </FrameLayout>
            </FrameLayout>

            <!-- Item Title -->
            <TextView
                android:id="@+id/tvItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                tools:text="Black Leather Wallet" />

            <!-- Timeline-Style Grouped Metadata Box with circular icons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/edit_text_rounded"
                android:padding="8dp"
                android:layout_marginBottom="10dp">

                <!-- Vertical Accent Bar indicator -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="52dp"
                    android:background="@color/primaryColor" />

                <!-- Location & Date Stack -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <!-- Location Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <!-- Circular Accent Frame for Location Icon -->
                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_accent_light">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_location"
                                app:tint="@color/primaryColor"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvItemLocation"
                            style="@style/TextAppearance.App.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Found near Library" />
                    </LinearLayout>

                    <!-- Date/Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Circular Neutral Frame for Calendar Icon -->
                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_neutral_light">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/textHint"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvItemDate"
                            style="@style/TextAppearance.App.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="2 March 2026" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Prominent Full-Width Gradient Action Button with Right Chevron -->
            <TextView
                android:id="@+id/btnViewDetails"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/btn_gradient_primary"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_view_details"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="2dp"
                android:drawableEnd="@drawable/ic_chevron_right_small"
                android:drawableTint="@color/white"
                android:drawablePadding="6dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
