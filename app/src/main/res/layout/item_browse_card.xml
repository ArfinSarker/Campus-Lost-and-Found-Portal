<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="8dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:clipToOutline="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/surfaceColor"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Prominent landscape image section at the top of the card (16:10 ratio for cinematic mobile view) -->
        <FrameLayout
            android:id="@+id/flImageContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/bg_f1f5f9"
            app:layout_constraintDimensionRatio="H,16:10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Image Slider for multiple images -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerSlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Single image display -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_package"
                android:contentDescription="@null" />

            <!-- Slider Indicators -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                android:visibility="gone"
                app:tabBackground="@drawable/slider_indicator_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="14dp"
                app:tabMinWidth="14dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@null" />

            <!-- Soft top gradient scrim to ensure overlay badge text is always readable -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_top_gradient_overlay"
                android:alpha="0.8" />

        </FrameLayout>

        <!-- Status Badge Overlay (Left) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="1.5dp"
            app:strokeColor="#FFFFFF">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"
                tools:text="PENDING" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Report ID Badge Overlay (Right) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReportId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardBackgroundColor="#CC0F172A"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF">

            <TextView
                android:id="@+id/tvDisplayId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-medium"
                tools:text="#R1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Clean, subtle separator line directly below the image -->
        <View
            android:id="@+id/vImageSeparator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/dividerColor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flImageContainer" />

        <!-- Details information panel below the image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/vImageSeparator"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Item Title -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fillViewport="true"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvItemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Black Leather Wallet" />
            </HorizontalScrollView>

            <!-- Modern Metadata Stack -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Location Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/primaryColor"
                        android:contentDescription="@null" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:scrollbars="none"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvItemLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            tools:text="Found near Library" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Date/Time Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/textHint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvItemDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        tools:text="2 March 2026" />
                </LinearLayout>
            </LinearLayout>

            <!-- Refined Action Button with Right Chevron and Click Ripple -->
            <TextView
                android:id="@+id/btnViewDetails"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/btn_gradient_primary"
                android:foreground="?attr/selectableItemBackground"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_view_details"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:clickable="true"
                android:focusable="true"
                android:drawableEnd="@drawable/ic_chevron_right_small"
                android:drawableTint="@color/white"
                android:drawablePadding="8dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
