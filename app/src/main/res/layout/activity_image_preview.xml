<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/image_preview_bg"
    android:fitsSystemWindows="true">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbarHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/image_preview_toolbar_bg"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/image_preview_tool_active"
            android:contentDescription="Cancel" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnClose"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:text="Preview &amp; Edit"
            android:textColor="@color/image_preview_tool_active"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnAddMorePhotos"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add_photo"
                app:tint="@color/image_preview_tool_active"
                android:contentDescription="Add More Photos" />

            <ImageButton
                android:id="@+id/btnDeletePhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete_trash"
                app:tint="@color/image_preview_tool_active"
                android:contentDescription="Delete Photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Send"
                android:textColor="@color/image_preview_btn_send_text"
                android:backgroundTint="@color/image_preview_btn_send_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_send"
                app:iconTint="@color/image_preview_btn_send_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Image Display Container -->
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarHeader"
        app:layout_constraintBottom_toTopOf="@id/rvThumbnails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Image Preview" />
    </FrameLayout>

    <!-- Horizontal Thumbnail Carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvThumbnails"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/image_preview_toolbar_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/layoutEditingToolbar" />

    <!-- Bottom Editing Tools Bar -->
    <LinearLayout
        android:id="@+id/layoutEditingToolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/image_preview_toolbar_bg"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutFilterOptions">

        <!-- Rotate Tool -->
        <LinearLayout
            android:id="@+id/btnToolRotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_rotate"
                app:tint="@color/image_preview_tool_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rotate"
                android:textColor="@color/image_preview_tool_active"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Flip Tool -->
        <LinearLayout
            android:id="@+id/btnToolFlip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flip"
                app:tint="@color/image_preview_tool_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flip"
                android:textColor="@color/image_preview_tool_active"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Filter Tool -->
        <LinearLayout
            android:id="@+id/btnToolFilter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/image_preview_tool_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filter"
                android:textColor="@color/image_preview_tool_active"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Reset Tool -->
        <LinearLayout
            android:id="@+id/btnToolReset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/image_preview_tool_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textColor="@color/image_preview_tool_active"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Presets Horizontal Selector -->
    <HorizontalScrollView
        android:id="@+id/layoutFilterOptions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/image_preview_toolbar_bg"
        android:visibility="gone"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomSpacer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterNormal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Normal"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterBw"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="B&amp;W"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterSepia"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Warm / Sepia"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterVintage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cool / Contrast"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/layoutBottomSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
