<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvNotificationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/notification_card_stroke_read"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llNotificationRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Circular Avatar with Overlapping Type Badge -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clAvatarContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Main Circular Profile Photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_notification_icon_container"
                android:backgroundTint="@color/avatar_bg"
                android:src="@drawable/ic_user"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Overlapping Circular Type Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBadgeContainer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/surfaceColor"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:layout_constraintBottom_toBottomOf="@id/ivNotificationIcon"
                app:layout_constraintEnd_toEndOf="@id/ivNotificationIcon">

                <ImageView
                    android:id="@+id/ivTypeBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/white" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Notification Message & Metadata Text Container -->
        <LinearLayout
            android:id="@+id/llTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/clAvatarContainer"
            app:layout_constraintEnd_toStartOf="@id/viewUnreadIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/notification_text_primary"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:textColorLink="@color/notification_link_color" />

            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/notification_timestamp_text"
                android:textSize="12sp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_clock"
                android:drawablePadding="5dp"
                app:drawableTint="@color/notification_clock_icon" />

        </LinearLayout>

        <!-- Circular Unread Indicator Dot on the Right -->
        <View
            android:id="@+id/viewUnreadIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_notification_badge"
            android:backgroundTint="@color/notification_unread_indicator"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteNotification"
            app:layout_constraintStart_toEndOf="@id/llTextContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Low-profile Sleek Delete Action Button -->
        <ImageButton
            android:id="@+id/btnDeleteNotification"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/notification_delete_icon"
            android:contentDescription="@string/btn_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>