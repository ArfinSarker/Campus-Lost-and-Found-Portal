<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportFoundRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rf_screen_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rf_header_bg"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/rf_icon_back"
            app:title=""
            app:titleTextColor="@color/rf_text_primary">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/report_found_btn"
                android:textColor="@color/rf_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textColor="@color/rf_section_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilItemName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Item Name"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary"
                    android:textColorHint="@color/rf_text_secondary"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategory"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Category"
                app:boxBackgroundColor="@color/rf_dropdown_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:endIconTint="@color/rf_dropdown_arrow"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/rf_dropdown_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Description"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary"
                    android:textColorHint="@color/rf_text_secondary"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.App.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Upload Image"
                android:textColor="@color/rf_upload_label_text"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/uploadCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/transparent">

                <LinearLayout
                    android:id="@+id/layoutUploadMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rf_upload_dashed"
                    android:padding="16dp">

                    <!-- State 1: Empty / Prompt State (Visible by default) -->
                    <LinearLayout
                        android:id="@+id/layoutUploadEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/ivUploadIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_upload"
                            app:tint="@color/rf_icon_upload"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvUploadTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_upload_image"
                            android:textColor="@color/rf_upload_title_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUploadSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tap_to_upload"
                            android:textColor="@color/rf_upload_subtitle_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- State 2: Scrollable Thumbnail List (Gone by default) -->
                    <HorizontalScrollView
                        android:id="@+id/scrollUploadImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/layoutUploadImagesContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Found Details"
                android:textColor="@color/rf_section_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Date"
                    app:boxBackgroundColor="@color/rf_input_bg"
                    app:boxStrokeColor="@color/rf_input_border"
                    app:hintTextColor="@color/rf_text_secondary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:startIconTint="@color/rf_icon_calendar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateFound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rf_text_primary"
                        android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTime"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="Time"
                    app:boxBackgroundColor="@color/rf_input_bg"
                    app:boxStrokeColor="@color/rf_input_border"
                    app:hintTextColor="@color/rf_text_secondary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:startIconDrawable="@drawable/ic_clock"
                    app:startIconTint="@color/rf_icon_clock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTimeFound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rf_text_primary"
                        android:focusable="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLocation"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Location"
                app:boxBackgroundColor="@color/rf_dropdown_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:endIconTint="@color/rf_dropdown_arrow"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/rf_dropdown_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilManualLocation"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Enter Location"
                android:visibility="gone"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etManualLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLocationDetails"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Additional Location Details"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocationDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Handling Status"
                android:textColor="@color/rf_section_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHandlingStatus"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Current Item Status"
                app:boxBackgroundColor="@color/rf_dropdown_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:endIconTint="@color/rf_dropdown_arrow"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvHandlingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/rf_dropdown_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAuthorityName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Authority/Person Name"
                android:visibility="gone"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAuthorityName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOfficeRoom"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Office/Room Number"
                android:visibility="gone"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOfficeRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verification &amp; Security"
                android:textColor="@color/rf_section_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHiddenQuestion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Security Question for Owner"
                app:helperText="A question only the owner could answer (e.g., Lock screen wallpaper)"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHiddenQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Contact Information"
                android:textColor="@color/rf_section_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContactName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Your Name"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/rf_text_primary"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <!-- Country Code Selection -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCountryCode"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="153dp"
                    android:layout_height="0dp"
                    android:hint="Code"
                    app:boxBackgroundColor="@color/rf_dropdown_bg"
                    app:boxStrokeColor="@color/rf_input_border"
                    app:hintTextColor="@color/rf_text_secondary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/rf_icon_phone"
                    app:endIconMode="none"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tilContactPhone"
                    app:layout_constraintBottom_toBottomOf="@+id/tilContactPhone">

                    <AutoCompleteTextView
                        android:id="@+id/actvCountryCode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="56dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="text"
                        android:textColor="@color/rf_dropdown_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone Number Body -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilContactPhone"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Contact Phone"
                    app:boxBackgroundColor="@color/rf_input_bg"
                    app:boxStrokeColor="@color/rf_input_border"
                    app:hintTextColor="@color/rf_text_secondary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tilCountryCode"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContactPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:inputType="phone"
                        android:textColor="@color/rf_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContactEmail"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Contact Email"
                app:boxBackgroundColor="@color/rf_input_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/rf_icon_email"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContactEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/rf_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPreferredContact"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Preferred Contact"
                app:boxBackgroundColor="@color/rf_dropdown_bg"
                app:boxStrokeColor="@color/rf_input_border"
                app:hintTextColor="@color/rf_text_secondary"
                app:endIconTint="@color/rf_dropdown_arrow"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvPreferredContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/rf_dropdown_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="I confirm that the information provided is accurate."
                android:textColor="@color/rf_text_secondary"
                app:buttonTint="@color/rf_btn_bg" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit Report"
                    android:backgroundTint="@color/rf_btn_bg"
                    android:textColor="@color/rf_btn_text" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/loadingAnimation"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/submit_loader" />
            </FrameLayout>

            <View
                android:id="@+id/keyboardSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>