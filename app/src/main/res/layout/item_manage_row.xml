<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="8dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/manage_card_bg"
    app:strokeWidth="1.2dp"
    app:strokeColor="@color/manage_card_border"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Image Container with fixed Aspect Ratio for uniformity -->
        <FrameLayout
            android:id="@+id/flImageContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,16:10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerSlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivItemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_package"
                android:background="@color/manage_header_bg"
                android:contentDescription="@string/item_image_description" />

            <TextView
                android:id="@+id/tvIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/manage_header_bg"
                android:gravity="center"
                android:text="📦"
                android:textSize="36sp"
                android:visibility="gone" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent"
                android:visibility="gone"
                app:tabBackground="@drawable/slider_indicator_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="10dp"
                app:tabMinWidth="10dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@null" />

            <!-- Soft top gradient scrim to ensure overlay badge text is always readable -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_top_gradient_overlay"
                android:alpha="0.8" />
        </FrameLayout>

        <!-- Status Badge Overlay (Left) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/manage_badge_stroke">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"
                tools:text="PENDING" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Report ID Badge Overlay (Right) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReportId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardBackgroundColor="#CC0F172A"
            app:strokeWidth="1dp"
            app:strokeColor="@color/manage_card_border">

            <TextView
                android:id="@+id/tvDisplayId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-medium"
                tools:text="#R1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Clean, subtle separator line directly below the image -->
        <View
            android:id="@+id/vImageSeparator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/manage_card_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/flImageContainer" />

        <!-- Info Content Section with balanced padding and modern typography -->
        <LinearLayout
            android:id="@+id/llDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vImageSeparator">

            <!-- Item Title / Name -->
            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/manage_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Black Lenovo Backpack" />

            <!-- Location Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    android:contentDescription="@null"
                    app:tint="@color/manage_icon_location" />

                <TextView
                    android:id="@+id/tvItemLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/manage_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    tools:text="Library Ground Floor" />
            </LinearLayout>

            <!-- Bottom Row: Date & Action Link -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- Date/Time -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_clock"
                        android:contentDescription="@null"
                        app:tint="@color/manage_icon_time" />

                    <TextView
                        android:id="@+id/tvItemDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/manage_date_text"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        tools:text="15 May 2024" />
                </LinearLayout>

                <!-- Chevron Right Link -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_right_small"
                    android:contentDescription="@null"
                    app:tint="@color/manage_icon_chevron" />

            </RelativeLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
