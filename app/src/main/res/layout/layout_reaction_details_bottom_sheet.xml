<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_reaction_details_bottom_sheet">

    <!-- Handle drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#88888888"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Title and total count -->
    <TextView
        android:id="@+id/tvReactionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reactions"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/messenger_text_primary"
        android:layout_marginBottom="16dp" />

    <!-- Horizontal Scrollable Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutReactionTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/reaction_details_divider"
        android:layout_marginBottom="12dp" />

    <!-- Users Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp">

        <!-- List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReactionUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Empty state placeholder -->
        <LinearLayout
            android:id="@+id/layoutReactionEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No reactions yet"
                android:textColor="@color/messenger_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
