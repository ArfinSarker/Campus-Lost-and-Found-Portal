<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dashboard_background"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primaryDarkColor"
            android:fitsSystemWindows="true"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:src="@drawable/ic_menu"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_title"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivNotificationIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_notification_badge"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/primaryColor"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/primaryColor"
                app:tabTextColor="@color/textSecondary"
                app:tabRippleColor="#262AABEE"
                app:tabBackground="@android:color/transparent">

                <com.google.android.material.tabs.TabItem android:text="@string/tab_home" />
                <com.google.android.material.tabs.TabItem android:text="@string/tab_browse" />
                <com.google.android.material.tabs.TabItem android:text="@string/tab_message" />
            </com.google.android.material.tabs.TabLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Welcome Section Banner Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:id="@+id/layoutWelcomeBg"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:background="@drawable/bg_dashboard_welcome">

                            <!-- Semi-transparent decorative graduation cap icon on the right -->
                            <ImageView
                                android:id="@+id/ivWelcomeWatermark"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="-10dp"
                                android:alpha="0.15"
                                android:src="@drawable/ic_graduation_cap"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="20dp"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvWelcome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/welcomeUser"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:fontFamily="sans-serif-black"
                                    android:gravity="center" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <!-- Lost Reports Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardUserLostReports"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/dashboard_lost_card_bg"
                            app:strokeColor="@color/dashboard_lost_card_stroke"
                            app:strokeWidth="@dimen/dashboard_card_stroke_width"
                            android:clickable="true"
                            android:focusable="true">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvUserLostCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/dashboard_lost_count_color"
                                    android:textSize="36sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <TextView
                                    android:id="@+id/tvUserLostLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Lost Reports"
                                    android:textColor="@color/dashboard_card_label_color"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/layoutIconLost"
                                    app:layout_constraintTop_toBottomOf="@+id/tvUserLostCount"
                                    app:layout_constraintBottom_toBottomOf="parent"/>

                                <FrameLayout
                                    android:id="@+id/layoutIconLost"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_indicator_pill"
                                    android:backgroundTint="@color/dashboard_lost_icon_bg"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_warning"
                                        app:tint="@color/dashboard_lost_count_color" />
                                </FrameLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Found Reports Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardUserFoundReports"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/dashboard_found_card_bg"
                            app:strokeColor="@color/dashboard_found_card_stroke"
                            app:strokeWidth="@dimen/dashboard_card_stroke_width"
                            android:clickable="true"
                            android:focusable="true">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvUserFoundCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/dashboard_found_count_color"
                                    android:textSize="36sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>

                                <TextView
                                    android:id="@+id/tvUserFoundLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Found Reports"
                                    android:textColor="@color/dashboard_card_label_color"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/layoutIconFound"
                                    app:layout_constraintTop_toBottomOf="@+id/tvUserFoundCount"
                                    app:layout_constraintBottom_toBottomOf="parent"/>

                                <FrameLayout
                                    android:id="@+id/layoutIconFound"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/bg_indicator_pill"
                                    android:backgroundTint="@color/dashboard_found_icon_bg"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_check_circle"
                                        app:tint="@color/dashboard_found_count_color" />
                                </FrameLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <!-- Report Lost Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportLost"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/report_lost_btn"
                            android:textAllCaps="false"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/dashboard_lost_btn_text"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:minWidth="110dp"
                            android:background="@drawable/bg_btn_report_lost"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_alert_circle"
                            app:iconGravity="textStart"
                            app:iconTint="@color/dashboard_lost_btn_text"
                            app:iconSize="16dp"
                            app:iconPadding="4dp"
                            app:elevation="0dp" />

                        <!-- Report Found Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportFound"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/report_found_btn"
                            android:textAllCaps="false"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/dashboard_found_btn_text"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="16dp"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:minWidth="110dp"
                            android:background="@drawable/bg_btn_report_found"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_check_circle"
                            app:iconGravity="textStart"
                            app:iconTint="@color/dashboard_found_btn_text"
                            app:iconSize="16dp"
                            app:iconPadding="4dp"
                            app:elevation="0dp" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp">

                        <TextView
                            style="@style/TextAppearance.App.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recent_reports_title" />

                        <TextView
                            android:id="@+id/tvBrowseAll"
                            style="@style/TextAppearance.App.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/browse_all_arrow"
                            android:textColor="@color/dashboard_browse_all_color"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:listitem="@layout/item_campus_reported_recent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewLess"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="View Less"
                        android:textAllCaps="false"
                        android:textColor="@color/dashboard_view_more_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/dashboard_view_more_bg"
                        app:strokeColor="@color/dashboard_view_more_stroke"
                        app:strokeWidth="1dp"
                        app:cornerRadius="24dp"
                        app:rippleColor="@color/dashboard_view_more_ripple"
                        app:icon="@drawable/ic_chevron_up"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/dashboard_view_more_text"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:elevation="0dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewMore"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="View More"
                        android:textAllCaps="false"
                        android:textColor="@color/dashboard_view_more_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/dashboard_view_more_bg"
                        app:strokeColor="@color/dashboard_view_more_stroke"
                        app:strokeWidth="1dp"
                        app:cornerRadius="24dp"
                        app:rippleColor="@color/dashboard_view_more_ripple"
                        app:icon="@drawable/ic_chevron_down"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/dashboard_view_more_text"
                        app:iconSize="18dp"
                        app:iconPadding="8dp"
                        app:elevation="0dp"
                        android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/dashboard_view_more_stroke"
                        app:strokeWidth="1dp"
                        app:cardPreventCornerOverlap="false">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_dashboard_help">

                            <!-- Subtle background watermark icon on the right -->
                            <ImageView
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="-10dp"
                                android:layout_marginBottom="-15dp"
                                android:alpha="0.18"
                                android:src="@drawable/ic_info"
                                app:tint="@color/white" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="24dp">

                                <!-- Rounded Icon Badge -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/badgeHelpIcon"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="@color/cardBackgroundColor"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_info"
                                        app:tint="@color/primaryColor" />
                                </com.google.android.material.card.MaterialCardView>

                                <!-- Title -->
                                <TextView
                                    android:id="@+id/tvHelpTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/need_help"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:fontFamily="sans-serif-bold"
                                    app:layout_constraintStart_toEndOf="@id/badgeHelpIcon"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="@id/badgeHelpIcon"
                                    app:layout_constraintBottom_toBottomOf="@id/badgeHelpIcon" />

                                <!-- Description -->
                                <TextView
                                    android:id="@+id/tvHelpDesc"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:text="@string/helpDescription"
                                    android:textColor="#BFC5CD"
                                    android:textSize="14sp"
                                    android:lineSpacingMultiplier="1.25"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/badgeHelpIcon" />

                                <!-- Main Call to Action Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnReportProblem"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:text="@string/reportProblem"
                                    android:textColor="@color/white"
                                    android:textSize="15sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textAllCaps="false"
                                    android:background="@drawable/btn_gradient_primary"
                                    app:backgroundTint="@null"
                                    app:icon="@drawable/ic_alert_circle"
                                    app:iconTint="@color/white"
                                    app:iconSize="18dp"
                                    app:iconPadding="8dp"
                                    app:elevation="4dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tvHelpDesc"
                                    app:layout_constraintBottom_toBottomOf="parent" />

                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDeveloperInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="12dp"
                        android:background="@drawable/bg_dev_info_button"
                        android:text="@string/developer_info_short"
                        android:textAlignment="center"
                        android:textColor="@color/dev_btn_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.App.NavigationView"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_campus_dashboard_drawer"
        app:itemIconTint="@color/nav_drawer_item_icon"
        app:itemTextColor="@color/nav_drawer_item_text"
        app:itemRippleColor="@color/nav_drawer_ripple" />

</androidx.drawerlayout.widget.DrawerLayout>
