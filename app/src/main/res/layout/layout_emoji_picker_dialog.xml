<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_emoji_picker_sheet"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/ep_divider" />

    <!-- Modern Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_emoji_search_bar"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="@color/ep_text_secondary"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_emoji_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Search emoji"
            android:textColorHint="@color/ep_text_secondary"
            android:textColor="@color/ep_search_bar_text"
            android:textSize="15sp"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </LinearLayout>

    <!-- Quick Category Selectors (Horizontal Scroll Bar) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/layout_category_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tab_recent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🕘"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_frequent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="💯"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_favorites"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="⭐"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_smileys"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="😀"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_people"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="👋"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_animals"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🐶"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_food"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🍔"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_travel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🌍"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_activities"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="⚽"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_objects"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="📦"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_symbols"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🔣"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_flags"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🏳️"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tab_component"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="👨‍👩‍👧‍👦"
                android:textSize="20sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ep_divider"
        android:layout_marginBottom="12dp" />

    <!-- "Your Reactions" customization section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Reactions"
            android:textColor="@color/ep_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/btn_customize_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOMIZE"
            android:textColor="@color/ep_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackground"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- 6 customize reaction slot elements -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/slot_0"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="👍"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />

        <TextView
            android:id="@+id/slot_1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="❤️"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />

        <TextView
            android:id="@+id/slot_2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="😂"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />

        <TextView
            android:id="@+id/slot_3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="😮"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />

        <TextView
            android:id="@+id/slot_4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="😢"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />

        <TextView
            android:id="@+id/slot_5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:text="😡"
            android:textSize="28sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_emoji_slot" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ep_divider"
        android:layout_marginBottom="8dp" />

    <!-- Grid items recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_emoji_categories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="true" />
</LinearLayout>
