<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chatBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primaryDarkColor"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back_arrow"
            app:navigationIconTint="@color/white">

            <TextView
                android:id="@+id/tvHeaderTitle"
                style="@style/TextAppearance.App.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Report Details"
                android:textColor="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Reporter Information Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReporterInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="Submitted By"
                                android:textColor="@color/primaryColor"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnViewProfile"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="View Profile"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/primaryColor"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="0dp"
                                app:strokeColor="@color/primaryColor"
                                app:strokeWidth="1.2dp"
                                app:cornerRadius="6dp"
                                android:letterSpacing="0.05"
                                android:minWidth="0dp"
                                android:minHeight="0dp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="#E5E7EB" />

                        <!-- Profile Header Block -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_vertical">

                            <!-- Avatar Circle -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardAvatar"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_alignParentStart="true"
                                app:cardBackgroundColor="@color/primaryLightColor"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_user"
                                    app:tint="@color/primaryColor" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Name and Role stacked -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/cardAvatar"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvReporterName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Name: ..."
                                    android:textColor="@color/textPrimary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvReporterRole"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Role: ..."
                                    android:textColor="@color/textSecondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="#E5E7EB" />

                        <!-- University ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_admin_id"
                                app:tint="@color/textSecondary" />
                            <TextView
                                android:id="@+id/tvReporterUniversityId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="University ID: ..."
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Dept/Designation -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_building"
                                app:tint="@color/textSecondary" />
                            <TextView
                                android:id="@+id/tvReporterDeptDesignation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Department: ..."
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Phone -->
                        <LinearLayout
                            android:id="@+id/layoutReporterPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/textSecondary" />
                            <TextView
                                android:id="@+id/tvReporterPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Phone: ..."
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Email -->
                        <LinearLayout
                            android:id="@+id/layoutReporterEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="8dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_envelope"
                                app:tint="@color/textSecondary" />
                            <TextView
                                android:id="@+id/tvReporterEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Email: ..."
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Report Information Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Premium left accent bar -->
                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/primaryColor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Report Details"
                                android:textColor="@color/primaryColor"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="12dp"
                                android:background="#E5E7EB" />

                            <TextView
                                android:id="@+id/tvDetailTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Report Title"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Category"
                                android:textColor="@color/primaryColor"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDetailDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:lineSpacingMultiplier="1.2"
                                android:text="Detailed Information"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="12dp"
                                android:background="#E5E7EB" />

                            <!-- Related report container -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_package"
                                    app:tint="@color/primaryColor" />

                                <TextView
                                    android:id="@+id/tvDetailRelatedId"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:text="Related Report ID: ..."
                                    android:textColor="@color/primaryColor"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>


                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Evidence Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Supporting Evidence"
                            android:textColor="@color/primaryColor"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:background="#E5E7EB" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="240dp">

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/viewPagerEvidence"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/ivDetailEvidence"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Evidence" />

                            <com.google.android.material.tabs.TabLayout
                                android:id="@+id/tabLayoutIndicator"
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginBottom="8dp"
                                android:background="@android:color/transparent"
                                android:visibility="gone"
                                app:tabBackground="@drawable/slider_indicator_selector"
                                app:tabGravity="center"
                                app:tabIndicatorHeight="0dp"
                                app:tabMaxWidth="14dp"
                                app:tabMinWidth="14dp"
                                app:tabPaddingStart="0dp"
                                app:tabPaddingEnd="0dp"
                                app:tabMode="fixed"
                                app:tabRippleColor="@null" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Admin Review Section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Action &amp; Decision"
                            android:textColor="@color/primaryColor"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="16dp" />



                        <!-- Status Selection -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUpdateStatus"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Update Status"
                            app:startIconDrawable="@drawable/ic_status">
                            <AutoCompleteTextView
                                android:id="@+id/actvUpdateStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Static Reviewed Status (Visible when reviewed) -->
                        <TextView
                            android:id="@+id/tvReviewedStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_report_id_badge"
                            android:backgroundTint="#E3F2FD"
                            android:gravity="center"
                            android:padding="12dp"
                            android:text="REVIEWED &amp; COMPLETED"
                            android:textColor="#2196F3"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <!-- Admin Notes Section -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:hint="Resolution Note"
                            app:startIconDrawable="@drawable/ic_note">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdminNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="3"
                                android:gravity="start|top"
                                android:inputType="textMultiLine"
                                android:textColor="@color/textPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Save Updates Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateReport"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="Save Resolution"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_check"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />

                        <!-- Delete Report Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteReport"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="Delete Report"
                            android:textColor="@color/errorColor"
                            android:textStyle="bold"
                            app:backgroundTint="@color/transparent"
                            app:strokeColor="@color/errorColor"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_delete"
                            app:iconGravity="textStart"
                            app:iconTint="@color/errorColor" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
