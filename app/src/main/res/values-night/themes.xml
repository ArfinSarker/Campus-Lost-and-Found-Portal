<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryLightColor</item>
        <item name="colorOnPrimaryContainer">@color/primaryDarkColor</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accentColor</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Navigation Drawer Selected Item Background -->
        <item name="colorSecondaryContainer">@color/primaryLightColor</item>
        <item name="colorOnSecondaryContainer">@color/primaryColor</item>

        <!-- Background and surface -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>

        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>

        <!-- Animation style -->
        <item name="android:windowAnimationStyle">@style/Animation.App.Activity</item>

        <!-- Use materialTimePickerTheme for styling the MaterialTimePicker -->
        <item name="materialTimePickerTheme">@style/ThemeOverlay.App.TimePicker.Dark</item>

        <!-- Use materialCalendarTheme for styling the MaterialDatePicker -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.App.DatePicker.Dark</item>

        <!-- TextInputLayout Style -->
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        
        <!-- Exposed Dropdown Style -->
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoCompleteTextView</item>

        <!-- Text Cursor & Selection Tint (Night Mode - Electric Lavender/Indigo) -->
        <item name="android:textCursorDrawable">@drawable/bg_cursor</item>
        <item name="android:colorControlActivated">@color/cursor_color</item>
        <item name="android:colorControlHighlight">#33818CF8</item>
    </style>

    <style name="Widget.App.AutoCompleteTextView" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:popupBackground">@color/dropdown_popup_bg</item>
    </style>

    <!-- Theme Overlay for TimePicker to achieve the requested look (Dark Mode) -->
    <style name="ThemeOverlay.App.TimePicker.Dark" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <!-- Responsive sizing to make it slightly larger and comfortable on all devices -->
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="windowMinWidthMajor">65%</item>
        <item name="windowMinWidthMinor">90%</item>

        <!-- Main dialog background -->
        <item name="colorSurface">@color/tp_night_bg</item>
        <item name="colorContainer">@color/tp_night_bg</item>
        <item name="colorSurfaceContainer">@color/tp_night_bg</item>
        <item name="colorSurfaceContainerHigh">@color/tp_night_bg</item>
        <item name="colorSurfaceContainerHighest">@color/tp_night_bg</item>

        <!-- "Select Time" title text color -->
        <item name="colorOnSurface">@color/tp_night_primary_text</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TimePicker.Title.Dark</item>

        <!-- Hour and Minute Display (Header Chips) -->
        <!-- Selected Chip - Dedicated background and text -->
        <item name="colorPrimaryContainer">@color/tp_night_box_bg_selected</item>
        <item name="colorOnPrimaryContainer">@color/tp_night_box_text_selected</item>

        <!-- Unselected Chip - Dedicated background and text -->
        <item name="colorSurfaceVariant">@color/tp_night_box_bg_unselected</item>
        <item name="colorOnSurfaceVariant">@color/tp_night_box_text_unselected</item>

        <!-- Border for chips -->
        <item name="colorOutline">@color/tp_night_border</item>

        <!-- AM/PM Toggle -->
        <!-- Selected background and text -->
        <item name="colorTertiaryContainer">@color/tp_night_ampm_bg_selected</item>
        <item name="colorOnTertiaryContainer">@color/tp_night_ampm_text_selected</item>
        <!-- Unselected background and text -->
        <item name="colorSecondaryContainer">@color/transparent</item>
        <item name="colorOnSecondaryContainer">@color/tp_night_ampm_text_unselected</item>
        <!-- Border for AM/PM buttons -->
        <item name="colorOutlineVariant">@color/tp_night_border</item>

        <!-- Analog Clock selector hand and circle -->
        <item name="colorPrimary">@color/tp_night_hand_indicator</item>
        <!-- Number inside selector circle -->
        <item name="colorOnPrimary">@color/tp_night_selected_number_text</item>

        <!-- Dial numbers styling -->
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.TimePicker.LabelBold.Dark</item>
        <!-- Time digits display styling -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.TimePicker.Headline.Dark</item>

        <item name="materialTimePickerStyle">@style/Widget.App.MaterialTimePicker.Dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.TimePicker.Button.Dark</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.TimePicker.Button.Dark</item>
    </style>

    <style name="TextAppearance.App.TimePicker.Title.Dark" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/tp_night_primary_text</item>
    </style>

    <style name="TextAppearance.App.TimePicker.Headline.Dark" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.TimePicker.LabelBold.Dark" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tp_night_dial_number_text</item>
    </style>

    <style name="Widget.App.MaterialTimePicker.Dark" parent="Widget.Material3.MaterialTimePicker">
        <!-- Dial background -->
        <item name="clockFaceBackgroundColor">@color/tp_night_clock_face_bg</item>
        <!-- Dial numbers text color -->
        <item name="clockNumberTextColor">@color/tp_night_dial_number_text</item>
    </style>

    <style name="Widget.App.TimePicker.Button.Dark" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/tp_night_button_text</item>
    </style>

    <!-- Theme Overlay for DatePicker (Dark Mode) -->
    <style name="ThemeOverlay.App.DatePicker.Dark" parent="ThemeOverlay.Material3.MaterialCalendar">
        <!-- Responsive sizing to make it comfortable on all devices -->
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="windowMinWidthMajor">65%</item>
        <item name="windowMinWidthMinor">90%</item>

        <!-- Header background and selected date circle -->
        <item name="colorPrimary">@color/dp_night_selection_indicator</item>
        <item name="colorOnPrimary">@color/dp_night_selected_text</item>

        <!-- Background of the calendar section -->
        <item name="colorSurface">@color/dp_night_bg</item>
        <item name="colorContainer">@color/dp_night_bg</item>
        <item name="colorSurfaceContainer">@color/dp_night_bg</item>
        <item name="colorSurfaceContainerHigh">@color/dp_night_bg</item>
        <item name="colorSurfaceContainerHighest">@color/dp_night_bg</item>

        <!-- Text color on the calendar -->
        <item name="colorOnSurface">@color/dp_night_unselected_text</item>
        <item name="colorOnSurfaceVariant">@color/dp_night_icon_tint</item>

        <!-- Month/Year selector and navigation arrows -->
        <item name="colorSecondary">@color/dp_night_icon_tint</item>
        <!-- Custom Header text styling for high contrast -->
        <item name="materialCalendarHeaderTitle">@style/Widget.App.MaterialCalendar.HeaderTitle.Dark</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.App.MaterialCalendar.HeaderSelection.Dark</item>
        <!-- Custom body text style mappings for unified typography -->
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.DatePicker.Month.Dark</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.DatePicker.Weekday.Dark</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.DatePicker.Day.Dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DatePicker.Button.Dark</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DatePicker.Button.Dark</item>
    </style>

    <style name="Widget.App.MaterialCalendar.HeaderTitle.Dark" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dp_night_header_text</item>
    </style>

    <style name="Widget.App.MaterialCalendar.HeaderSelection.Dark" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dp_night_primary_text</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Month.Dark" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dp_night_primary_text</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Weekday.Dark" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dp_night_secondary_text</item>
    </style>

    <style name="TextAppearance.App.DatePicker.Day.Dark" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/dp_night_unselected_text</item>
    </style>

    <style name="Widget.App.DatePicker.Button.Dark" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/dp_night_button_text</item>
    </style>
</resources>
