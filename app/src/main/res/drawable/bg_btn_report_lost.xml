<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dashboard_lost_btn_ripple">
    <item>
        <selector>
            <!-- Pressed state -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/dashboard_lost_btn_pressed_start"
                        android:endColor="@color/dashboard_lost_btn_pressed_end"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/dashboard_lost_btn_pressed_stroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Hovered / Focused state -->
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/dashboard_lost_btn_hovered_start"
                        android:endColor="@color/dashboard_lost_btn_hovered_end"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="@color/dashboard_lost_btn_hovered_stroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/dashboard_lost_btn_default_start"
                        android:endColor="@color/dashboard_lost_btn_default_end"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/dashboard_lost_btn_default_stroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
