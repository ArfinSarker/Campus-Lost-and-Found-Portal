<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFF3B30">
    <item>
        <selector>
            <!-- Pressed state -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#3DFF8A80"
                        android:endColor="#3DFF3B30"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#99FF3B30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Hovered / Focused state -->
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#2BFF8A80"
                        android:endColor="#2BFF3B30"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#66FF3B30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1FFF8A80"
                        android:endColor="#1FFF3B30"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#4DFF3B30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
