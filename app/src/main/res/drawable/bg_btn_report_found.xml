<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D34C759">
    <item>
        <selector>
            <!-- Pressed state -->
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#3D82E9A1"
                        android:endColor="#3D34C759"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#9934C759" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Hovered / Focused state -->
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#2B82E9A1"
                        android:endColor="#2B34C759"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#6634C759" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1F82E9A1"
                        android:endColor="#1F34C759"
                        android:angle="45"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#4D34C759" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
